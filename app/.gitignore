# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Large curated 3D sources are uploaded to Tencent COS.
/web/immersive/assets/*.sog

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Tencent Push credentials downloaded from Tencent/vendor consoles.
/android/app/src/main/assets/timpush-configs.json
/android/app/google-services.json
/android/app/agconnect-services.json
/android/app/mcs-services.json
/ios/Runner/*.p8
/ios/Runner/*.p12
