# 生产构建与部署（在托管平台配置为环境变量，勿提交真实密钥）
NODE_ENV=production

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 高德 Web 服务 API Key（仅服务端使用，用于官方组织地址解析）
AMAP_WEB_SERVICE_KEY=
# 完成一次生产地理编码验收后设为 1（非密钥，仅用于后台自检记录）
AMAP_SMOKE_TESTED=0

# 大模型（/api/v1/ai/consult、/api/v1/ai/chat、/api/v1/ai/schools/search 共用）
# DeepSeek / OpenAI 兼容配置。使用 DeepSeek 时推荐填下面三项。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 兼容 fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MOONSHOT_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL 为 OPENAI_BASE_URL 的 fallback，通常无需单独配置
# AI_BASE_URL=

# Embedding 配置（本项目默认：本地 Ollama bge-m3，1024 维）
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=dummy
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=50

# 如果使用本地 Xinference（需自行部署）:
# EMBEDDING_PROVIDER=xinference
# XINFERENCE_BASE_URL=http://your-xinference-server:9997/v1
# XINFERENCE_API_KEY=dummy
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=32

# 部署后的站点 URL（若前端或回调需要）
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# 腾讯云：COS 上传 + 内容安全审核（服务端专用）
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_CLOUD_REGION=ap-guangzhou
# TENCENT_CLOUD_SECURITY_TOKEN=

TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
# 可选：仅在自定义域名已完成 DNS/HTTPS 后配置；上传结果始终保留 COS 源站 URL
# TENCENT_COS_PUBLIC_BASE_URL=https://assets.artiqore.com
TENCENT_COS_SIGN_EXPIRES_SECONDS=600
TENCENT_COS_TIMEOUT_MS=10000
TENCENT_COS_MAX_UPLOADS_PER_10_MINUTES=30
# 私有资料默认回退 Supabase 私有桶；只有启用 COS 严格签名/隔离私有桶后才设为 true
TENCENT_COS_PRIVATE_DIRECT_UPLOAD_ENABLED=false
TENCENT_COS_CORS_CONFIGURED=0

TENCENT_CONTENT_SAFETY_TEXT_BIZ_TYPE=
TENCENT_CONTENT_SAFETY_IMAGE_BIZ_TYPE=
# TENCENT_CONTENT_SAFETY_ALLOWED_IMAGE_HOSTS=assets.artiqore.com
TENCENT_CONTENT_SAFETY_MAX_UNITS_PER_MINUTE=60
TENCENT_CONTENT_SAFETY_SMOKE_TESTED=0
TENCENT_CLOUD_TIMEOUT_MS=10000
TENCENT_CLOUD_MAX_ATTEMPTS=2

# 腾讯云：短信验证码（服务端专用；签名与模板必须已审核通过）
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# 必须与模板变量顺序完全一致；支持 code 或 code,ttl_minutes。
TENCENT_SMS_TEMPLATE_PARAM_ORDER=code
TENCENT_SMS_CODE_TTL_SECONDS=300
TENCENT_SMS_ALLOW_INTERNATIONAL=0
# 腾讯云验证码：短信发送前先完成人机验证，AppSecretKey 仅保存在 BFF。
# 部署挑战页与票据校验并验收后再改为 1。
TENCENT_CAPTCHA_REQUIRED=0
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_APP_SECRET_KEY=
TENCENT_CAPTCHA_MAX_EVIL_LEVEL=0
TENCENT_CAPTCHA_ALLOWED_ORIGINS=https://artiqore.com
TENCENT_CAPTCHA_CONSOLE_CONFIGURED=0
TENCENT_CAPTCHA_SMOKE_TESTED=0
# 独立随机密钥，用于 HMAC 哈希验证码/IP；不要复用或提交真实值。
SMS_OTP_PEPPER=
SMS_OTP_MAX_ATTEMPTS=5
SMS_PHONE_COOLDOWN_SECONDS=60
SMS_PHONE_HOURLY_LIMIT=5
SMS_PHONE_DAILY_LIMIT=10
SMS_IP_HOURLY_LIMIT=20
SMS_IP_DAILY_LIMIT=100
SMS_GLOBAL_HOURLY_LIMIT=100
SMS_GLOBAL_DAILY_LIMIT=500
TENCENT_SMS_CONSOLE_GUARDS_CONFIGURED=0
TENCENT_SMS_SMOKE_TESTED=0

# 腾讯云：即时通信 IM / Chat（服务端专用，勿暴露给 Flutter / 浏览器）
TENCENT_IM_SDK_APP_ID=
TENCENT_IM_SECRET_KEY=
TENCENT_IM_ADMIN_USER_ID=administrator
TENCENT_IM_USER_SIG_EXPIRES_SECONDS=604800
# 国内站默认 console.tim.qq.com；若腾讯云提示 SDKAppID 与域名不匹配，再按应用地域改这里。
TENCENT_IM_REST_HOST=console.tim.qq.com
TENCENT_IM_REST_TIMEOUT_MS=5000
TENCENT_IM_REST_MAX_ATTEMPTS=2
TENCENT_IM_LOGIN_CONFIG_REQUESTS_PER_MINUTE=12
# 通知正文不包含私信内容，降低锁屏泄露风险；客户端推送注册仍需腾讯控制台证书/厂商配置。
TENCENT_IM_OFFLINE_PUSH_TITLE=艺见心新消息
# 腾讯 IM 回调独立鉴权 Token（建议 `openssl rand -hex 32`）；需与控制台完全一致。
TENCENT_IM_CALLBACK_TOKEN=
# 迁移和回调部署完成后再设为 1；启用后 BFF 为每条 REST 消息签发一次性放行票据。
TENCENT_IM_REQUIRE_BFF_CALLBACK=0
TENCENT_IM_CALLBACK_PERMIT_TTL_SECONDS=45
# 控制台发送前回调、失败不下发均核对后设为 1
TENCENT_IM_CALLBACK_CONSOLE_CONFIGURED=0
# Push Key/APNs/Android 厂商或 FCM、正式客户端构建分别核对后设为 1
TENCENT_PUSH_CONSOLE_CONFIGURED=0
TENCENT_PUSH_CLIENT_BUILD_CONFIGURED=0
TENCENT_PUSH_SMOKE_TESTED=0
# 若只想先生成 UserSig、不调用 IM account_import，可设为 1。
TENCENT_IM_SKIP_ACCOUNT_IMPORT=0
# 若只想本地测试 Supabase 好友关系、不调用 IM friend_add，可设为 1。
TENCENT_IM_SKIP_FRIENDSHIP_SYNC=0
